rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in ['rpe_admin@ft.fr'];
      // Cette liste doit rester identique a ADMIN_EMAILS dans firebase-config.js
    }

    // Entrees du glossaire validees par l'administrateur : lecture publique,
    // ecriture reservee a l'admin (ecrite uniquement depuis admin.html).
    match /glossaire_ajouts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /glossaire_overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Compteurs de demandes en attente par fiche (aucune donnée personnelle) :
    // lecture publique pour afficher le badge "en attente" ; increment/decrement
    // par tout utilisateur authentifie (visiteur a la soumission, admin a la decision).
    match /compteurs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contenu editable de la page d'accueil (agenda, actualites, webinaires...) :
    // lecture publique, ecriture reservee a l'admin (edite depuis admin.html).
    match /site_content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Abonnes a la newsletter : email uniquement, pas de lecture publique
    // (protection de la liste). Un visiteur authentifie anonymement peut
    // creer/mettre a jour/supprimer SA PROPRE inscription (email = id du document) ;
    // seul l'admin peut lister l'ensemble des abonnes.
    match /newsletter_subscribers/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if request.auth != null;
    }

    // Propositions des utilisateurs : n'importe quel visiteur (authentifie de
    // maniere anonyme) peut en creer une. Seul l'admin peut les lire (les
    // emails des contributeurs ne doivent etre visibles que par lui), les
    // corriger ou les supprimer.
    match /propositions/{id} {
      allow create: if request.auth != null
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.email is string
        && request.resource.data.type in ['ajout', 'modification', 'suppression', 'groupe_lot', 'hierarchie_lot', 'groupe_suppression', 'hierarchie_suppression'];
      allow read, update, delete: if isAdmin();
    }

    // ==== Module FAQ ====

    // Referentiels partages (listes de pages, d'objets techniques...) et arborescence
    // Type > Perimetre > Precision : lecture publique (necessaire au formulaire),
    // ecriture reservee a l'admin (edites depuis admin.html).
    match /faq_referentiels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq_arbre/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Bandeau d'information de la page FAQ (texte de cadrage) : meme logique.
    match /faq_content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Questions/reponses : lecture publique UNIQUEMENT pour les questions publiees
    // (une question en attente ne doit jamais fuiter au public avant reponse admin -
    // email de l'auteur inclus). N'importe quel visiteur authentifie anonymement peut
    // creer une question (statut force a 'en_attente', reponse vide) ou incrementer/
    // decrementer un compteur de likes. Seul l'admin peut repondre/publier/supprimer,
    // et lire les questions en attente (file de moderation).
    match /faq_questions/{id} {
      allow read: if isAdmin() || resource.data.statut == 'publiee';
      allow create: if request.auth != null
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.reponse == ''
        && request.resource.data.email is string;
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_question', 'likes_reponse']));
      allow delete: if isAdmin();
    }
  }
}
