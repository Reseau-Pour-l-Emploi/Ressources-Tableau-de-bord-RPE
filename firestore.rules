rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in ['denis.gorce@francetravail.fr'];
      // Cette liste doit rester identique a ADMIN_EMAILS dans firebase-config.js
    }

    // Entrees du glossaire validees par l'administrateur : lecture publique,
    // ecriture reservee a l'admin (ecrite uniquement depuis admin.html).
    match /glossaire_ajouts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /glossaire_overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Compteurs de demandes en attente par fiche (aucune donnée personnelle) :
    // lecture publique pour afficher le badge "en attente" ; increment/decrement
    // par tout utilisateur authentifie (visiteur a la soumission, admin a la decision).
    match /compteurs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Propositions des utilisateurs : n'importe quel visiteur (authentifie de
    // maniere anonyme) peut en creer une. Seul l'admin peut les lire (les
    // emails des contributeurs ne doivent etre visibles que par lui), les
    // corriger ou les supprimer.
    match /propositions/{id} {
      allow create: if request.auth != null
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.email is string
        && request.resource.data.type in ['ajout', 'modification', 'suppression'];
      allow read, update, delete: if isAdmin();
    }
  }
}
